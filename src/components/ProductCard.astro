---
import { formatGbp, getPrice } from '../lib/products';
const { product } = Astro.props;
const activePrice = getPrice(product);
---
<article class="card">
  <a href={`/product/${product.slug}`}>
    <img src={product.image_1 || '/images/placeholder.svg'} alt={product.title} loading="lazy" />
    <h3>{product.title}</h3>
  </a>
  <p class="muted">{product.short_description}</p>
  <p>
    {product.sale_price_gbp ? <s class="muted">{formatGbp(product.price_gbp)}</s> : null}
    <strong style="margin-left: .4rem;">{formatGbp(activePrice)}</strong>
  </p>
  <button
    class="btn"
    data-add-to-cart
    data-title={product.title}
    data-sku={product.sku}
    data-price={activePrice}
    data-price-id={product.stripe_price_id}
  >
    Add to basket
  </button>
</article>
