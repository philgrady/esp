---
const {
  title = 'ESP Store',
  description = 'Fast ecommerce catalogue built with Astro and Stripe Checkout.'
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/favicon.svg" />
    <style>
      :root { --bg: #f8f8f8; --text: #141414; --muted: #666; --accent: #1f6feb; --card: #fff; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: Inter, system-ui, Arial, sans-serif; background: var(--bg); color: var(--text); }
      a { color: inherit; text-decoration: none; }
      .container { width: min(1100px, 92vw); margin: 0 auto; }
      header, footer { background: white; border-bottom: 1px solid #e6e6e6; }
      header .inner, footer .inner { display:flex; align-items:center; justify-content:space-between; padding: 1rem 0; gap: 1rem; }
      nav { display:flex; gap: 0.75rem; flex-wrap: wrap; }
      nav a { padding: 0.45rem 0.65rem; border-radius: 0.5rem; }
      nav a:hover { background: #efefef; }
      .cart-badge { background: var(--accent); color: #fff; border-radius: 999px; padding: 0.1rem 0.45rem; font-size: .8rem; }
      main { min-height: 70vh; padding: 1.3rem 0 2.5rem; }
      .grid { display: grid; gap: 1rem; }
      .products-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
      .card { background: var(--card); border-radius: .8rem; padding: .85rem; border: 1px solid #ebebeb; }
      .btn { border: 0; border-radius: .5rem; padding: .65rem .85rem; background: var(--accent); color: white; cursor: pointer; }
      .btn.secondary { background: #f0f0f0; color: #111; }
      .muted { color: var(--muted); }
      img { width: 100%; border-radius: 0.6rem; }
      @media (max-width: 700px) {
        header .inner { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container inner">
        <a href="/"><strong>ESP Store</strong></a>
        <nav>
          <a href="/products">Shop</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/delivery">Delivery</a>
          <a href="/returns">Returns</a>
          <a href="/cart">Cart <span class="cart-badge" id="cart-count">0</span></a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <div class="container inner">
        <small>© {new Date().getFullYear()} ESP Store</small>
        <nav>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>
    </footer>
    <script>
      const cart = JSON.parse(localStorage.getItem('esp-cart') || '[]');
      const count = cart.reduce((acc, item) => acc + item.qty, 0);
      const badge = document.getElementById('cart-count');
      if (badge) badge.textContent = String(count);
    </script>
  </body>
</html>
